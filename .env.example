# LLM Configuration
CODEPILOT_LLM_API_KEY=sk-your-api-key-here
CODEPILOT_LLM_BASE_URL=https://api.openai.com/v1
CODEPILOT_LLM_MODEL=gpt-4o

# Agent Configuration
CODEPILOT_WORKSPACE_ROOT=./workspace
CODEPILOT_MAX_TOOL_CALLS=20
CODEPILOT_COMMAND_TIMEOUT=60

# Context envelope (estimated tokens); reserve must cover LLM max_tokens
CODEPILOT_CONTEXT_MAX_INPUT_TOKENS=32768
CODEPILOT_CONTEXT_RESERVE_OUTPUT_TOKENS=4096
CODEPILOT_CONTEXT_TOOL_OUTPUT_LIMIT=2048
CODEPILOT_CONTEXT_RECENT_MESSAGE_COUNT=6
